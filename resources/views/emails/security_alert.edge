<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alerte Sécurité - AigleSend</title>
    <style>
        :root {
            --cerulean: #09adca;
            --aztec: #091418;
            --tarawera: #07404b;
            --blizzard-blue: #a0dce9;
            --mosque: #066071;
            --blue-chill: #08879e;
            --iceberg: #dcf1f4;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f4f8;
            color: #091418;
            line-height: 1.6;
        }

        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(9, 20, 24, 0.1);
        }

        .header {
            padding: 20px;
            text-align: center;
        }

        .header-critical {
            background-color: #DC2626;
        }

        .header-warning {
            background-color: #D97706;
        }

        .header-info {
            background-color: #08879e;
        }

        .header-title {
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .logo-section {
            background-color: #07404b;
            padding: 16px 20px;
            text-align: center;
        }

        .logo-img {
            max-width: 120px;
            height: auto;
        }

        .content {
            padding: 32px 40px;
            background-color: #ffffff;
        }

        .summary {
            margin-bottom: 24px;
            color: #4a5568;
            font-size: 15px;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
        }

        .details-table td {
            padding: 10px 12px;
            border: 1px solid #e2e8f0;
            font-size: 14px;
        }

        .details-table .label {
            font-weight: 600;
            color: #07404b;
            width: 40%;
            background-color: #f7fafc;
        }

        .details-table .value {
            color: #2d3748;
            word-break: break-word;
        }

        .badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .badge-critical {
            background-color: #FEE2E2;
            color: #DC2626;
        }

        .badge-warning {
            background-color: #FEF3C7;
            color: #D97706;
        }

        .badge-info {
            background-color: #dcf1f4;
            color: #066071;
        }

        .context-section {
            margin-top: 24px;
        }

        .context-title {
            font-size: 14px;
            font-weight: 600;
            color: #07404b;
            margin-bottom: 8px;
        }

        .context-block {
            background-color: #f7fafc;
            padding: 14px;
            border-radius: 6px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            color: #4a5568;
            overflow-x: auto;
            white-space: pre-wrap;
            word-break: break-word;
            border: 1px solid #e2e8f0;
        }

        .info-box {
            background-color: #dcf1f4;
            padding: 16px;
            border-radius: 8px;
            margin-top: 24px;
            font-size: 13px;
            color: #066071;
            border-left: 4px solid #08879e;
        }

        .footer {
            background-color: #091418;
            padding: 24px;
            text-align: center;
            color: #a0dce9;
            font-size: 12px;
        }

        .footer p {
            margin-bottom: 6px;
        }

        @media screen and (max-width: 600px) {
            .email-container {
                margin: 0;
                border-radius: 0;
            }

            .content {
                padding: 24px 16px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Logo -->
        <div class="logo-section">
            <img src="https://res.cloudinary.com/dskfw5taz/image/upload/v1758212299/logo_aigle.22a46313_wa20fk.png" alt="AigleSend Logo" class="logo-img">
        </div>

        <!-- Alert Header -->
        <div class="header {{ alertLevel === 'critical' ? 'header-critical' : (alertLevel === 'warning' ? 'header-warning' : 'header-info') }}">
            <div class="header-title">
                {{ alertLevel === 'critical' ? 'ALERTE SÉCURITÉ CRITIQUE' : (alertLevel === 'warning' ? 'AVERTISSEMENT SÉCURITÉ' : 'NOTIFICATION SÉCURITÉ') }}
            </div>
        </div>

        <!-- Content -->
        <div class="content">
            <div class="summary">
                {{ alertSummary }}
            </div>

            <table class="details-table">
                <tr>
                    <td class="label">Type</td>
                    <td class="value">{{ alertType }}</td>
                </tr>
                <tr>
                    <td class="label">Sévérité</td>
                    <td class="value">
                        <span class="badge {{ alertLevel === 'critical' ? 'badge-critical' : (alertLevel === 'warning' ? 'badge-warning' : 'badge-info') }}">
                            {{ severity }}
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="label">Acteur</td>
                    <td class="value">{{ actorType }} #{{ actorId }}</td>
                </tr>
                <tr>
                    <td class="label">Adresse IP</td>
                    <td class="value">{{ ipAddress || 'Non disponible' }}</td>
                </tr>
                <tr>
                    <td class="label">Détecté le</td>
                    <td class="value">{{ detectedAt }}</td>
                </tr>
            </table>

            @if(metadata)
              <div class="context-section">
                  <div class="context-title">Contexte technique</div>
                  <div class="context-block">{{ JSON.stringify(metadata, null, 2) }}</div>
              </div>
            @end

            <div class="info-box">
                <strong>Action recommandée :</strong>
                {{ recommendedAction }}
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>Alerte automatique envoyée par AigleSend.</p>
            <p>&copy; {{ new Date().getFullYear() }} AigleSend. Tous droits réservés.</p>
        </div>
    </div>
</body>
</html>
