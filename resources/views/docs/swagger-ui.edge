<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5/swagger-ui.css" />
  <style>
    :root {
      --bg: #fafafa; --topbar-bg: #1b1b1b; --topbar-fg: #fff;
      --text: #3b4151; --link: #4990e2; --btn-bg: #4990e2; --btn-fg: #fff;
    }
    html.dark {
      --bg: #1a1a2e; --topbar-bg: #16213e; --topbar-fg: #e0e0e0;
      --text: #c9d1d9; --link: #58a6ff; --btn-bg: #0f3460; --btn-fg: #e0e0e0;
    }
    body { margin: 0; background: var(--bg); color: var(--text); transition: background .3s, color .3s; }
    /* Top navigation bar */
    .custom-topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.6rem 1.5rem; background: var(--topbar-bg); color: var(--topbar-fg);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 8px rgba(0,0,0,.15);
    }
    .custom-topbar .title { font-size: 1.15rem; font-weight: 600; letter-spacing: .3px; }
    .custom-topbar nav { display: flex; gap: .75rem; align-items: center; }
    .custom-topbar a {
      color: var(--topbar-fg); text-decoration: none; padding: .35rem .85rem;
      border-radius: 6px; font-size: .85rem; border: 1px solid rgba(255,255,255,.2);
      transition: background .2s;
    }
    .custom-topbar a:hover { background: rgba(255,255,255,.12); }
    .custom-topbar a.active { background: rgba(255,255,255,.18); font-weight: 600; }
    /* Dark mode toggle */
    .theme-toggle {
      background: none; border: 1px solid rgba(255,255,255,.25); color: var(--topbar-fg);
      padding: .35rem .7rem; border-radius: 6px; cursor: pointer; font-size: 1rem;
      transition: background .2s;
    }
    .theme-toggle:hover { background: rgba(255,255,255,.12); }
    /* Swagger UI dark overrides */
    html.dark .swagger-ui { color: var(--text); }
    html.dark .swagger-ui .topbar { display: none; }
    html.dark .swagger-ui .info .title, html.dark .swagger-ui .info p,
    html.dark .swagger-ui .opblock-tag, html.dark .swagger-ui .opblock-summary-description,
    html.dark .swagger-ui .opblock-description-wrapper p,
    html.dark .swagger-ui .response-col_description__inner p,
    html.dark .swagger-ui table thead tr th, html.dark .swagger-ui table tbody tr td,
    html.dark .swagger-ui .parameter__name, html.dark .swagger-ui .parameter__type,
    html.dark .swagger-ui .model-title, html.dark .swagger-ui .model { color: #c9d1d9; }
    html.dark .swagger-ui .opblock .opblock-summary { border-color: #30363d; }
    html.dark .swagger-ui .opblock { background: rgba(255,255,255,.03); border-color: #30363d; }
    html.dark .swagger-ui section.models { border-color: #30363d; }
    html.dark .swagger-ui section.models .model-container { background: rgba(255,255,255,.03); }
    html.dark .swagger-ui .scheme-container { background: var(--bg); box-shadow: none; }
    html.dark .swagger-ui select { background: #0d1117; color: #c9d1d9; border-color: #30363d; }
    html.dark .swagger-ui input[type=text], html.dark .swagger-ui textarea { background: #0d1117; color: #c9d1d9; border-color: #30363d; }
    html.dark .swagger-ui .btn { background: var(--btn-bg); color: var(--btn-fg); border-color: #30363d; }
    html.dark .swagger-ui .topbar { background: var(--topbar-bg); }
    html.dark .swagger-ui .info a { color: var(--link); }
    /* Light mode: hide default topbar too */
    .swagger-ui .topbar { display: none; }
  </style>
</head>
<body>
  <div class="custom-topbar">
    <span class="title">🦅 Aigle Send API</span>
    <nav>
      <a href="/docs">🏠 Index</a>
      <a href="/docs/mobile">📱 Mobile</a>
      <a href="/docs/admin">🔧 Admin</a>
      <button class="theme-toggle" onclick="toggleTheme()" title="Basculer le thème">🌙</button>
    </nav>
  </div>
  <div id="swagger-ui"></div>
  <script src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js"></script>
  <script>
    // Theme management
    function getTheme() { return localStorage.getItem('swagger-theme') || 'light'; }
    function applyTheme(t) {
      document.documentElement.classList.toggle('dark', t === 'dark');
      document.querySelector('.theme-toggle').textContent = t === 'dark' ? '☀️' : '🌙';
    }
    function toggleTheme() {
      const t = getTheme() === 'dark' ? 'light' : 'dark';
      localStorage.setItem('swagger-theme', t); applyTheme(t);
    }
    applyTheme(getTheme());

    // Active link
    document.querySelectorAll('.custom-topbar nav a').forEach(a => {
      if (a.getAttribute('href') === location.pathname) a.classList.add('active');
      else a.classList.remove('active');
    });

    SwaggerUIBundle({
      url: '{{ specUrl }}',
      dom_id: '#swagger-ui',
      presets: [SwaggerUIBundle.presets.apis, SwaggerUIBundle.SwaggerUIStandalonePreset],
      layout: 'BaseLayout',
      deepLinking: true,
      defaultModelsExpandDepth: 1,
      docExpansion: 'list',
    });
  </script>
</body>
</html>
