{
  "name": "aigle_api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build  --ignore-ts-errors",
    "dev": "node ace serve --hmr",
    "migration": "node ace make:migration",
    "migration:fresh": "node ace migration:fresh",
    "migrate": "node ace migration:run",
    "migrations:status": "node ace migration:status",
    "model": "node ace make:model",
    "seed": "node ace db:seed",
    "seeder": "node ace make:seeder",
    "test": "node --enable-source-maps --import @poppinss/ts-exec bin/test.ts",
    "controller": "node ace make:controller",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js",
    "#features/*": "./app/features/*.js",
    "#shared/*": "./app/shared/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@japa/snapshot": "^2.0.10",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.7.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.30.0",
    "hot-hook": "^0.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.59.1",
    "prettier": "^3.3.3",
    "swagger-jsdoc": "^6.2.8",
    "typescript": "^5.9.3",
    "youch": "^4.1.0"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/cache": "^2.0.1",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/limiter": "^3.0.0",
    "@adonisjs/lucid": "^22.1.1",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/otel": "^1.2.3",
    "@adonisjs/queue": "^0.6.0",
    "@adonisjs/redis": "^10.0.0",
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/s3-request-presigner": "^3.936.0",
    "@google-cloud/storage": "^7.15.0",
    "@maxmind/geoip2-node": "^6.3.4",
    "@vinejs/vine": "^4.3.0",
    "axios": "1.13.5",
    "chalk": "^5.3.0",
    "edge.js": "^6.5.0",
    "expo-server-sdk": "^4.0.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.1.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.11.3",
    "pg": "^8.18.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^10.0.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "strtok3": "8.0.1"
  },
  "resolutions": {
    "strtok3": "8.0.1"
  },
  "pnpm": {
    "overrides": {
      "strtok3": "8.0.1"
    }
  },
  "prettier": "@adonisjs/prettier-config"
}
