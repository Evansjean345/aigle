# =============================================================================
# TAG de l'image docker
# =============================================================================
API_TAG=v0.1.1

# =============================================================================
# AdonisJS — runtime
# =============================================================================
TZ=UTC
NODE_ENV=development
APP_NAME="Aigle send (dev)"
APP_VERSION=0.0.1
APP_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# URL de l'API en dev (port 3380 hôte → 3333 conteneur)
APP_URL=http://localhost:3380/api

# Clé d'app Adonis (32 chars URL-safe)
APP_KEY=replace-with-32-random-chars-for-dev

# =============================================================================
# OpenTelemetry (vide en dev local — pas de collector qui tourne)
# =============================================================================
# Décommenter et pointer vers la stack monitoring pour activer en dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# MariaDB (hostnames Docker : mariadb)
# =============================================================================
DB_HOST=mariadb
DB_PORT=3306
DB_USER=aiglesend
DB_PASSWORD=changeme-32-chars-min
DB_DATABASE=aiglesend

MYSQL_ROOT_PASSWORD=changeme-32-chars-min
MYSQL_DATABASE=aiglesend
MYSQL_USER=aiglesend
MYSQL_PASSWORD=changeme-32-chars-min

# =============================================================================
# Postgres audit (hostname Docker : postgres)
# =============================================================================
AUDIT_DB_HOST=postgres
AUDIT_DB_PORT=5432
AUDIT_DB_USER=aiglesend_audit
AUDIT_DB_PASSWORD=changeme-32-chars-min
AUDIT_DB_DATABASE=aiglesend_audit

POSTGRES_DB=aiglesend_audit
POSTGRES_USER=aiglesend_audit
POSTGRES_PASSWORD=changeme-32-chars-min

# =============================================================================
# Redis (hostname Docker : redis)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-32-chars-min

QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=changeme-32-chars-min

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=replace-with-64-random-hex-chars-for-dev
JWT_ALG=HS256

# =============================================================================
# Aigle Hub — gateway de test
# =============================================================================
API_BASE_URL=http://localhost:8080
API_TRANSFERT_URL=/api/services/mobile-money/transfer
API_CHECKOUT_URL=/api/services/payment
API_AIRTIME_URL=/api/services/airtimes/recharges
API_AIRTIME_COUNTRY_URL=/api/services/airtimes/countries

AIGLE_HUB_API_KEY=changeme-aigle-hub-api-key-dev
AIGLE_HUB_SECRET=changeme-aigle-hub-secret-dev

# =============================================================================
# Webhooks (calculés depuis APP_URL)
# =============================================================================
NOTIFY_SUCCESS_URL=$APP_URL/mobile/webhooks/transfer/success
NOTIFY_FAILURE_URL=$APP_URL/mobile/webhooks/transfer/failure

NOTIFY_DEPOSIT_SUCCESS_URL=$APP_URL/mobile/webhooks/deposit/success
NOTIFY_DEPOSIT_FAILURE_URL=$APP_URL/mobile/webhooks/deposit/failure

NOTIFY_TRANSFERT_INTER_SUCCESS_URL=$APP_URL/mobile/webhooks/transfer-inter/success
NOTIFY_TRANSFERT_INTER_FAILURE_URL=$APP_URL/mobile/webhooks/transfer-inter/failure
NOTIFY_TRANSFERT_INTER_SECOND_SUCCESS_URL=$APP_URL/mobile/webhooks/transfer-inter/second/success
NOTIFY_TRANSFERT_INTER_SECOND_FAILURE_URL=$APP_URL/mobile/webhooks/transfer-inter/second/failure

NOTIFY_AIRTIME_SUCCESS_URL=$APP_URL/web_hook/airtime/first-step/success
NOTIFY_AIRTIME_FAILURE_URL=$APP_URL/web_hook/airtime/first-step/failure
NOTIFY_AIRETIME_SECOND_SUCCESS_URL=$APP_URL/web_hook/airtime/second-step/success
NOTIFY_AIRETIME_SECOND_FAILURE_URL=$APP_URL/web_hook/airtime/second-step/failure

# =============================================================================
# Stockage (filesystem en dev pour pas dépendre d'AWS)
# =============================================================================
DRIVE_DISK=fs

# AWS sandbox (laisser vide ou mettre des values factices en dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=aiglesend-dev

# =============================================================================
# Cloudinary (sandbox de test recommandé)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# OTP / SMS — bypass activé en dev pour ne pas envoyer de vrais SMS
# =============================================================================
BYPASS_OTP_VERIFICATION=true
APP_REVIEW_PHONE_NUMBER=2250000000000

MTARGET_URL=https://api-public-2.mtarget.fr/messages
MTARGET_USERNAME=
MTARGET_PASSWORD=
MTARGET_SENDER=AigleSendDev

# =============================================================================
# Mobile app
# =============================================================================
MOBILE_DEVICE_DEEP_LINK_URL=https://aigle-send.expo.app/confirm-by-provider
MAX_DEVICE_CONNECTIONS=5

# =============================================================================
# Mail (Mailpit/Mailhog en local : SMTP_PORT=1025)
# Lancer Mailpit : docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# =============================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_PASSWORD=
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# =============================================================================
# MaxMind GeoIP (license gratuite : maxmind.com/en/geolite2/signup)
# =============================================================================
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./resources/data/maxmind

# =============================================================================
# Limiter & Queue
# =============================================================================
LIMITER_STORE=redis
QUEUE_DRIVER=redis

# =============================================================================
# Alertes (vide en dev — pas d'envoi réel)
# =============================================================================
ALERT_EMAIL_TECH_TEAM=dev1@example.com,dev2@example.com
ALERT_EMAIL_OPS_TEAM=
ALERT_EMAIL_FINANCE_TEAM=
